---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/sections/Header.astro';
import Footer from '../../../components/sections/Footer.astro';
import BlogHero from '../../../components/sections/BlogHero.astro';
import BlogAllArticles from '../../../components/sections/BlogAllArticles.astro';
import BlogPagination from '../../../components/ui/nav/BlogPagination.astro';

export async function getStaticPaths() {
  // ЛОКАЛЬНАЯ константа — исключает "PAGE_SIZE is not defined"
  const PAGE_SIZE = 6;

  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => +b.data.pubDate - +a.data.pubDate);

  const restCount = Math.max(0, posts.length - 1);
  const totalPages = Math.max(1, Math.ceil(restCount / PAGE_SIZE));

  // Генерируем страницы со 2-й: /blog/page/2 .. /blog/page/N
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const PAGE_SIZE = 6; // ещё раз локально для рендера страницы

const pageNum = Number(Astro.params.page || '2');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);

const [_featured, ...rest] = posts;

// Всего страниц СРЕДИ rest (первая — это /blog)
const totalPages = Math.max(1, Math.ceil(rest.length / PAGE_SIZE));

// Срез для текущей страницы
const start = (pageNum - 2) * PAGE_SIZE;
const pagePosts = rest.slice(start, start + PAGE_SIZE);
---

<html lang="ru" data-theme="dark" class="dark">
  <head>
    <BaseHead title={`Блог — страница ${pageNum}`} description={`Страница ${pageNum} блога: новые записи по дате.`} />
    {pageNum < totalPages && <link rel="next" href={`/blog/page/${pageNum + 1}/`} />}
    {pageNum === 2 && <link rel="prev" href={`/blog/`} />}
    {pageNum > 2 && <link rel="prev" href={`/blog/page/${pageNum - 1}/`} />}
  </head>
  <body>
    <Header />
    <BlogHero title="Блог" subtitle="Продолжение списка статей (без избранного поста с первой страницы)." />
    <main class="mx-auto max-w-6xl px-4 py-8 space-y-10">
      <BlogAllArticles posts={pagePosts} />
      <BlogPagination currentPage={pageNum} totalPages={totalPages} />
    </main>
    <Footer />
  </body>
</html>
