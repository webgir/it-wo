---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Импортируем функцию транслитерации
  const { slugifyTag } = await import('../../lib/slug');
  return posts.map((post) => {
    const categoryRaw = String(post.data.category ?? 'notes');
    const rawSlug = (post.data.slug ?? post.id).replace(/^.*\//,'').replace(/\.(md|mdx)$/,'');
    const slug = slugifyTag(rawSlug);
    return {
      params: { slug },
      props: {
        target: `/blog/${encodeURIComponent(categoryRaw)}/${encodeURIComponent(rawSlug)}/`,
      },
    };
  });
}

return Astro.redirect(Astro.props.target as string, 301);
---
