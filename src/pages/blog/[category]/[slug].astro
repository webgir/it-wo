---
import { getCollection } from 'astro:content';

// Сгенерируем все пути вида /blog/<category>/<slug>,
// чтобы на них отдать 301 на корневой /<slug>/
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const raw = (post.data.slug ?? post.id) as string;
    const slug = raw.replace(/^.*\//, '').replace(/\.(md|mdx)$/, '');
    const category = String(post.data.category ?? 'notes');
    return { params: { category, slug } };
  });
}

const { slug } = Astro.params;
return Astro.redirect(`/${slug}/`, 301);
---
