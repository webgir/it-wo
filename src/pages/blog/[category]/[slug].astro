---
import { getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { calculateReadingTimeFromHtml } from '../../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const raw = ((post as any).slug ?? post.id) as string;
    const slug = raw.replace(/^.*\//, '').replace(/\.(md|mdx)$/,'');
    const category = String(post.data.category ?? 'notes');
    return { params: { category, slug } };
  });
}

const { category, slug } = Astro.params;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const post = posts.find(p => {
  const postSlug = (p.data.slug ?? p.id).replace(/^.*\//, '').replace(/\.(md|mdx)$/,'');
  const postCategory = String(p.data.category ?? 'notes');
  return postSlug === slug && postCategory === category;
});
if (!post) {
  return new Response(`Not found: category=${category}, slug=${slug}`,
    { status: 404 });
}

const sorted = posts.slice().sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const index = sorted.findIndex((p) => p.id === post.id);
const prevPost =
  index < sorted.length - 1
    ? {
        title: sorted[index + 1].data.title,
        href: `/blog/${category}/${(sorted[index + 1].data.slug ?? sorted[index + 1].id).replace(/^.*\//, '').replace(/\.(md|mdx)$/,'')}/`,
      }
    : null;
const nextPost =
  index > 0
    ? {
        title: sorted[index - 1].data.title,
        href: `/blog/${category}/${(sorted[index - 1].data.slug ?? sorted[index - 1].id).replace(/^.*\//, '').replace(/\.(md|mdx)$/,'')}/`,
      }
    : null;

const { render } = await import('astro:content');
const { Content, headings } = await render(post);
const html = await Astro.slots.render('default');
const readingTimeMin = calculateReadingTimeFromHtml(html ?? '');
const canonicalUrl = `/blog/${category}/${slug}/`;
const toc =
  headings
    ?.filter((heading) => heading.depth === 2 || heading.depth === 3)
    .map((heading) => ({
      id: heading.slug,
      level: heading.depth,
      text: heading.text,
    })) ?? [];
---

<BlogPost
  {...post.data}
  prevPost={prevPost}
  nextPost={nextPost}
  readingTimeMin={readingTimeMin}
  canonicalUrl={canonicalUrl}
  toc={toc}
>
  <Content />
</BlogPost>
