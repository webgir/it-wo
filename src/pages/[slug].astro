---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../layouts/BlogPost.astro";
import { calculateReadingTimeFromHtml } from "../lib/reading";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: {
      slug: ((post.data.slug ?? post.id) as string)
        .replace(/^.*\//, "")
        .replace(/\.(md|mdx)$/, ""),
    },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;
const post = Astro.props as Props;

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = posts.slice().sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const index = sorted.findIndex((p) => p.id === post.id);

// prev/next: сразу собираем href инлайном
const prevPost =
  index < sorted.length - 1
    ? {
        title: sorted[index + 1].data.title,
        href:
          "/" +
          ((sorted[index + 1].data.slug ?? sorted[index + 1].id) as string)
            .replace(/^.*\//, "")
            .replace(/\.(md|mdx)$/, "") +
          "/",
      }
    : null;

const nextPost =
  index > 0
    ? {
        title: sorted[index - 1].data.title,
        href:
          "/" +
          ((sorted[index - 1].data.slug ?? sorted[index - 1].id) as string)
            .replace(/^.*\//, "")
            .replace(/\.(md|mdx)$/, "") +
          "/",
      }
    : null;

const { Content } = await render(post);
const html = await Astro.slots.render("default");
const readingTimeMin = calculateReadingTimeFromHtml(html ?? "");

// canonical для статьи
const canonicalUrl =
  "/" +
  ((post.data.slug ?? post.id) as string)
    .replace(/^.*\//, "")
    .replace(/\.(md|mdx)$/, "") +
  "/";
---

<BlogPost
  {...post.data}
  showHeader={true}
  prevPost={prevPost}
  nextPost={nextPost}
  readingTimeMin={readingTimeMin}
  canonicalUrl={canonicalUrl}
>
  <Content />
</BlogPost>
