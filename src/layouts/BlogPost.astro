---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/sections/Header.astro';
import PostMeta from '../components/ui/meta/PostMeta.astro';
import PostNav from '../components/ui/nav/PostNav.astro';

type BlogData = CollectionEntry<'blog'>['data'];
type NavLink = { title: string; href: string } | null;
type Props = BlogData & {
  showHeader?: boolean;
  prevPost?: NavLink;
  nextPost?: NavLink;
  readingTimeMin?: number;
  canonicalUrl?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  showHeader = true,
  prevPost = null,
  nextPost = null,
  readingTimeMin = 0,
  canonicalUrl
} = Astro.props as Props;
---

<html lang="ru" data-theme="dark" class="dark">
  <head>
    <!-- @ts-ignore -->
    <BaseHead title={title} description={description} image={heroImage} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="article" />
    {pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
    <meta property="article:author" content={Astro.props.author || 'Site Author'} />
    {Array.isArray(Astro.props.tags) && Astro.props.tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <!-- JSON-LD: Article -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: heroImage ? new URL(heroImage, Astro.site).toString() : undefined,
      datePublished: pubDate ? new Date(pubDate).toISOString() : undefined,
      dateModified: updatedDate ? new Date(updatedDate).toISOString() : undefined,
      author: [{ '@type': 'Person', name: Astro.props.author || 'Site Author' }],
      publisher: { 
        '@type': 'Organization', 
        name: 'it-wo.ru',
        logo: {
          '@type': 'ImageObject',
          url: new URL('/logo.png', Astro.site).toString()
        }
      },
      mainEntityOfPage: canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString(),
      url: canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString(),
    })} />

    <!-- JSON-LD: Breadcrumbs -->
    <script type="application/ld+json" set:html={JSON.stringify((() => {
      const isBlogPath = Astro.url.pathname.startsWith('/blog/');
      const items = [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      ];
      if (isBlogPath) {
        items.push({ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).toString() });
        items.push({ '@type': 'ListItem', position: 3, name: title, item: (canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString()) });
      } else {
        items.push({ '@type': 'ListItem', position: 2, name: title, item: (canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString()) });
      }
      return { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items };
    })())} />
    <style>
      main {
        width: 1280px;
        max-width: calc(100% - 2em);
        margin: auto;
        background: var(--color-bg-primary);
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .content {
        width: 100%;
      }
      .sidebar {
        position: sticky;
        top: 2rem;
        height: fit-content;
        order: -1;
      }
      @media (min-width: 768px) {
        main {
          grid-template-columns: 1fr 300px;
        }
        .sidebar {
          order: 0;
        }
      }
      .toc {
        width: 100%;
        border-radius: 8px;
        border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
        background: var(--color-bg-elevated, rgba(22, 22, 22, 0.85));
        overflow: hidden;
      }
      .toc summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0;
        padding: 0.75rem 1rem;
        list-style: none;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text-primary);
      }
      .toc summary::-webkit-details-marker {
        display: none;
      }
      .toc summary::after {
        content: '>';
        display: inline-block;
        margin-left: 0.5rem;
        transform: rotate(90deg);
        transition: transform 0.2s ease;
      }
      .toc[open] summary::after {
        transform: rotate(-90deg);
      }
      .toc ul {
        list-style: none;
        padding: 0 1rem 1rem;
        margin: 0;
      }
      .toc li {
        margin-bottom: 0.35rem;
      }
      .toc a {
        display: block;
        color: var(--color-text-secondary);
        text-decoration: none;
        font-size: 0.85rem;
        line-height: 1.25;
        word-break: break-word;
      }
      .toc a:hover {
        color: var(--accent);
      }
      .toc .toc-h2 {
        font-weight: 600;
        margin-left: 0;
      }
      .toc .toc-h3 {
        margin-left: 0.75rem;
        font-size: 0.8rem;
      }
      @media (max-width: 767px) {
        .sidebar {
          position: static;
          order: -1;
        }
        .toc summary {
          font-size: 1rem;
        }
      }
      @media (min-width: 768px) {
        .toc summary {
          cursor: default;
        }
      }
      .hero-image { width: 100%; }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .prose {
        width: 100%;
        max-width: 870px;
        margin: auto;
        padding: 0.05em;
        color: var(--color-text-secondary);
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
        color: var(--color-text-primary);
      }
      .date { margin-bottom: 0.5em; color: var(--color-text-muted); }
      .last-updated-on { font-style: italic; }
    </style>
  </head>

  <body>
    <Header />
    <main id="top">
      <div class="content">
        <article>
          {showHeader && (
            <div class="hero-image">
              {heroImage && <img src={heroImage} alt="" width="1020" height="510" />}
            </div>
          )}
          <div class="prose">
            {showHeader && (
              <div class="title">
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
                <h1>{title}</h1>
                <hr />
              </div>
            )}
            <PostMeta pubDate={pubDate} readingTimeMin={readingTimeMin} authorName={'Site Author'} />
            <slot />
            <PostNav prev={prevPost} next={nextPost} />
          </div>
        </article>
      </div>
      <aside class="sidebar">
        <details class="toc" data-auto-toggle open>
          <summary>Contents</summary>
          <ul id="toc-list"></ul>
        </details>
      </aside>
    </main>
    <Footer />

    <!-- Lightbox script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const images = document.querySelectorAll('.prose img');
        images.forEach(img => {
          (img as HTMLElement).style.cursor = 'pointer';
          img.addEventListener('click', () => {
            const lightbox = document.createElement('div');
            lightbox.style.position = 'fixed';
            lightbox.style.top = '0';
            lightbox.style.left = '0';
            lightbox.style.width = '100%';
            lightbox.style.height = '100%';
            lightbox.style.backgroundColor = 'rgba(0,0,0,0.8)';
            lightbox.style.display = 'flex';
            lightbox.style.alignItems = 'center';
            lightbox.style.justifyContent = 'center';
            lightbox.style.zIndex = '1000';
            lightbox.addEventListener('click', () => {
              document.body.removeChild(lightbox);
            });

            const imgClone = img.cloneNode(true) as HTMLElement;
            (imgClone as HTMLElement).style.maxWidth = '90%';
            (imgClone as HTMLElement).style.maxHeight = '90%';
            (imgClone as HTMLElement).style.objectFit = 'contain';
            lightbox.appendChild(imgClone);

            document.body.appendChild(lightbox);
          });
        });
      });
    </script>

    <!-- TOC script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const tocDetails = document.querySelector('.toc');
        const tocList = document.getElementById('toc-list');
        const desktopQuery = window.matchMedia('(min-width: 768px)');

        const applyMediaState = () => {
          if (!(tocDetails instanceof HTMLDetailsElement)) {
            return;
          }
          if (desktopQuery.matches) {
            tocDetails.setAttribute('open', '');
            delete tocDetails.dataset.manualOpen;
          } else if (!tocDetails.dataset.manualOpen) {
            tocDetails.removeAttribute('open');
          }
        };

        if (tocDetails instanceof HTMLDetailsElement) {
          applyMediaState();

          const onMediaChange = () => applyMediaState();
          if (typeof desktopQuery.addEventListener === 'function') {
            desktopQuery.addEventListener('change', onMediaChange);
          } else if (typeof desktopQuery.addListener === 'function') {
            desktopQuery.addListener(onMediaChange);
          }

          tocDetails.addEventListener('toggle', () => {
            if (desktopQuery.matches) {
              tocDetails.setAttribute('open', '');
              return;
            }
            if (tocDetails.open) {
              tocDetails.dataset.manualOpen = 'true';
            } else {
              delete tocDetails.dataset.manualOpen;
            }
          });
        }

        if (tocList) {
          const topLi = document.createElement('li');
          const topA = document.createElement('a');
          topA.href = '#top';
          topA.textContent = 'Back to top';
          topA.className = 'toc-h2';
          topLi.appendChild(topA);
          tocList.appendChild(topLi);

          const headers = document.querySelectorAll('.prose h2, .prose h3');
          headers.forEach((header) => {
            if (!(header instanceof HTMLElement)) {
              return;
            }
            if (!header.id) {
              const slug = header.textContent
                ? header.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
                : '';
              if (slug) {
                header.id = slug;
              }
            }
            if (!header.id) {
              return;
            }
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = '#' + header.id;
            a.textContent = header.textContent ?? '';
            a.className = header.tagName === 'H2' ? 'toc-h2' : 'toc-h3';
            li.appendChild(a);
            tocList.appendChild(li);
          });
        }
      });
    </script>





