---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'Блог', subtitle } = Astro.props as Props;
---

<section class="w-full py-6 md:py-10 border-b border-[color:var(--muted)]">
  <div class="mx-auto max-w-5xl px-3">
    <div class="grid items-center gap-4 md:grid-cols-2">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-foreground leading-tight">
        <span class="bg-gradient-to-r from-[var(--accent)] to-[var(--accent-dark)] bg-clip-text text-transparent">
          {title}
        </span>
      </h1>
      {subtitle && (
        <p
          class="text-base md:text-lg text-[color:var(--color-text-secondary)] md:text-right"
          aria-label="Подзаголовок раздела блога"
        >
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
