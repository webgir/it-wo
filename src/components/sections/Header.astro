---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from '../ui/button/ThemeToggle.astro';

const { pathname } = Astro.url;
const isActive = (href: string) => {
  // Главная: строго "/"; остальные — по префиксу
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="bg-background text-foreground border-b sw-header">
  <nav class="mx-auto max-w-6xl px-4 py-2 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a class="no-underline hover:opacity-90 flex items-center gap-2" href="/" aria-label="Главная">
        <img src="/favicon.png?v=1" alt="" aria-hidden="true" width="45" height="45" />
        <span class="sr-only">{SITE_TITLE}</span>
      </a>
      <div class="internal-links hidden md:flex items-center gap-2 ml-1">
        <HeaderLink href="/" aria-current={isActive('/') ? 'page' : undefined} class="px-2 py-3 text-[color:var(--color-text-secondary)] no-underline">Главная</HeaderLink>
        <HeaderLink href="/portfolio" aria-current={isActive('/portfolio') ? 'page' : undefined} class="px-2 py-3 text-[color:var(--color-text-secondary)] no-underline">Портфолио</HeaderLink>
        <HeaderLink href="/about" aria-current={isActive('/about') ? 'page' : undefined} class="px-2 py-3 text-[color:var(--color-text-secondary)] no-underline">Обо мне</HeaderLink>
        <HeaderLink href="/blog" aria-current={isActive('/blog') ? 'page' : undefined} class="px-2 py-3 text-[color:var(--color-text-secondary)] no-underline">Блог</HeaderLink>
        <a href="#contact" class="px-2 py-3 text-[color:var(--color-text-secondary)] no-underline">Контакты</a>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="social-links hidden md:flex items-center gap-3">
        <a href="https://ru.pinterest.com/sikeysipi/" target="_blank" rel="noopener noreferrer" class="group text-[color:var(--color-text-secondary)]">
          <span class="sr-only">Pinterest</span>
          <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" class="transition-colors group-hover:text-[color:var(--accent)]">
            <path fill="currentColor" d="M8 0C3.588 0 0 3.588 0 8c0 3.187 1.867 5.938 4.555 7.11-.062-.602-.117-1.525.024-2.183.125-.535.805-3.422.805-3.422s-.206-.413-.206-1.023c0-.958.556-1.674 1.25-1.674.59 0 .875.444.875.975 0 .594-.378 1.484-.573 2.309-.163.694.346 1.26 1.028 1.26 1.234 0 2.18-1.302 2.18-3.183 0-1.664-1.196-2.824-2.902-2.824-1.977 0-3.141 1.48-3.141 3.009 0 .596.229 1.235.517 1.583.057.069.065.129.05.199-.051.218-.166.694-.189.791-.03.125-.099.152-.229.092-.856-.399-1.389-1.65-1.389-2.654 0-2.16 1.57-4.14 4.53-4.14 2.377 0 4.23 1.693 4.23 3.954 0 2.364-1.491 4.272-3.563 4.272-.695 0-1.348-.36-1.572-.788l-.427 1.625c-.153.586-.568 1.321-.845 1.768.634.195 1.305.301 2.005.301 4.412 0 8-3.588 8-8s-3.588-8-8-8z"/>
          </svg>
        </a>
        <a href="https://t.me/nejro_art" target="_blank" rel="noopener noreferrer" class="group text-[color:var(--color-text-secondary)]">
          <span class="sr-only">Telegram</span>
          <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" class="transition-colors group-hover:text-[color:var(--accent)]">
            <path fill="currentColor" d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.713 4.792-1.3 6.138c-.098.438-.356.545-.722.34l-2-1.476-.963.926c-.107.107-.198.198-.404.198l.144-2.053 3.739-3.377c.162-.144-.036-.224-.252-.08L5.93 8.69 3.94 8.092c-.43-.134-.438-.43.09-.635l7.055-2.723c.35-.126.655.08.623.358z"/>
          </svg>
        </a>
      </div>
      <ThemeToggle />
      <button type="button" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false" data-menu-btn class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-[color:var(--color-text-secondary)] hover:text-white">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden border-t">
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-2">
      <div class="flex flex-col">
        <HeaderLink href="/" aria-current={isActive('/') ? 'page' : undefined} class="px-2 py-3">Главная</HeaderLink>
        <HeaderLink href="/portfolio" aria-current={isActive('/portfolio') ? 'page' : undefined} class="px-2 py-3">Портфолио</HeaderLink>
        <HeaderLink href="/about" aria-current={isActive('/about') ? 'page' : undefined} class="px-2 py-3">Обо мне</HeaderLink>
        <HeaderLink href="/blog" aria-current={isActive('/blog') ? 'page' : undefined} class="px-2 py-3">Блог</HeaderLink>
        <a href="#contact" class="px-2 py-3">Контакты</a>
      </div>
      <div class="flex items-center gap-4 pt-2">
        <a href="https://ru.pinterest.com/sikeysipi/" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center text-[color:var(--color-text-secondary)]">
          <span class="sr-only">Pinterest</span>
          <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" class="transition-colors group-hover:text-white"><path fill="currentColor" d="M8 0C3.588 0 0 3.588 0 8c0 3.187 1.867 5.938 4.555 7.11-.062-.602-.117-1.525.024-2.183.125-.535.805-3.422.805-3.422s-.206-.413-.206-1.023c0-.958.556-1.674 1.25-1.674.59 0 .875.444.875.975 0 .594-.378 1.484-.573 2.309-.163.694.346 1.26 1.028 1.26 1.234 0 2.18-1.302 2.18-3.183 0-1.664-1.196-2.824-2.902-2.824-1.977 0-3.141 1.48-3.141 3.009 0 .596.229 1.235.517 1.583.057.069.065.129.05.199-.051.218-.166.694-.189.791-.03.125-.099.152-.229.092-.856-.399-1.389-1.65-1.389-2.654 0-2.16 1.57-4.14 4.53-4.14 2.377 0 4.23 1.693 4.23 3.954 0 2.364-1.491 4.272-3.563 4.272-.695 0-1.348-.36-1.572-.788l-.427 1.625c-.153.586-.568 1.321-.845 1.768.634.195 1.305.301 2.005.301 4.412 0 8-3.588 8-8s-3.588-8-8-8z"/></svg>
        </a>
        <a href="https://t.me/nejro_art" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center text-[color:var(--color-text-secondary)]">
          <span class="sr-only">Telegram</span>
          <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" class="transition-colors group-hover:text-white"><path fill="currentColor" d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.713 4.792-1.3 6.138c-.098.438-.356.545-.722.34l-2-1.476-.963.926c-.107.107-.198.198-.404.198l.144-2.053 3.739-3.377c.162-.144-.036-.224-.252-.08L5.93 8.69 3.94 8.092c-.43-.134-.438-.43.09-.635l7.055-2.723c.35-.126.655.08.623.358z"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.querySelector('[data-menu-btn]');
  const panel = document.getElementById('mobile-menu');

  function toggleMenu() {
    if (!panel || !btn) return;
    const isOpen = !panel.classList.contains('hidden');
    panel.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  }

  btn?.addEventListener('click', toggleMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel?.classList.contains('hidden')) toggleMenu();
  });
  document.addEventListener('click', (e) => {
    if (!panel || !btn) return;
    const target = e.target;
    const clickedInside = panel.contains(target) || btn.contains(target);
    if (!clickedInside && !panel.classList.contains('hidden')) toggleMenu();
  });
  // Закрывать меню при клике по ссылке внутри мобильной панели
  panel?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (!panel.classList.contains('hidden')) toggleMenu();
    });
  });
</script>
