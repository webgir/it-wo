---
import { SITE_TITLE } from "../../consts";
const today = new Date();
import contactIconRaw from "../../assets/icons/contact-icon.svg?raw";
import Button from "../ui/button/Button.astro";

function sanitizeToWhite(svg: string, size = 18) {
  let s = svg
    .replace(/<\?xml[\s\S]*?\?>/g, "")
    .replace(/<!--([\s\S]*?)-->/g, "")
    .replace(/width=\"[^\"]*\"/g, "")
    .replace(/height=\"[^\"]*\"/g, "")
    .replace(/fill=\"[^\"]*\"/gi, 'fill="currentColor"')
    // не отключаем stroke, а приводим к currentColor
    .replace(/stroke=\"[^\"]*\"/gi, 'stroke="currentColor"');
  s = s.replace(/<svg([^>]*)>/, (m, attrs) => `<svg${attrs} width="${size}" height="${size}" aria-hidden="true" focusable="false">`);
  return s;
}

const contactIcon = sanitizeToWhite(contactIconRaw);
const feedUrl = new URL('rss.xml', Astro.site).toString();
const feedlyUrl = `https://feedly.com/i/subscription/feed/${feedUrl}`;
const inoreaderUrl = `https://www.inoreader.com/?add_feed=${feedUrl}`;
---

<footer id="contact" class="py-12 px-4 text-center">
  <h2 class="text-2xl md:text-3xl font-semibold text-foreground">Хотите работать со мной?</h2>
  <p class="mt-2 text-[color:var(--color-text-muted)]">Давайте создадим что-нибудь вместе!</p>

  <div class="mt-6 flex justify-center">
    <Button href="https://www.linkedin.com/in/guihubie/" variant="secondary" size="md" aria-label="Связаться через LinkedIn">
      <span class="sr-only">Иконка контакта</span>
      <span class="inline-flex" aria-hidden="true" set:html={contactIcon} />
      Связаться
    </Button>
  </div>

  <div class="mt-6 text-sm text-[color:var(--color-text-muted)]">
    © {today.getFullYear()} {SITE_TITLE}. Сделано на Astro.
  </div>

  <div class="mt-6 flex items-center justify-center gap-4 text-sm">
    <a class="sw-btn-sm" href={feedlyUrl} target="_blank" rel="noopener noreferrer" aria-label="Подписаться в Feedly">Feedly</a>
    <a class="sw-btn-sm" href={inoreaderUrl} target="_blank" rel="noopener noreferrer" aria-label="Подписаться в Inoreader">Inoreader</a>
    <button class="sw-btn-sm" type="button" data-copy={feedUrl} aria-label="Скопировать ссылку RSS">Скопировать RSS</button>
    <a class="sw-btn-sm" href="/blog/" aria-label="Просмотреть все посты">Все посты</a>
  </div>

  <div class="sr-only" id="copy-status" aria-live="polite"></div>

  <script type="module">
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.matches('button[data-copy]')) {
        const url = target.getAttribute('data-copy');
        if (!url) return;
        navigator.clipboard?.writeText(url);
        const original = target.textContent || 'Скопировать RSS';
        target.textContent = 'Скопировано!';
        const status = document.getElementById('copy-status');
        if (status) status.textContent = 'Ссылка RSS скопирована в буфер обмена.';
        setTimeout(() => { target.textContent = original; }, 1500);
      }
    });
  </script>
</footer>
